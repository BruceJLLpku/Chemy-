# Copy to .env locally; never commit the real .env or put credentials in dist/.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
HOST=127.0.0.1
PORT=8788
ALLOWED_ORIGINS=http://127.0.0.1:8788,http://localhost:8788
AGENT_TIMEOUT_MS=45000
AGENT_MAX_CONCURRENT=2
AGENT_REQUESTS_PER_MINUTE=6
# Maximum upstream calls per UTC day (normally two calls for a paper).
AGENT_DAILY_CALL_LIMIT=200
